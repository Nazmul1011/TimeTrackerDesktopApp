# Production API (baked into Next static export at build time)
NEXT_PUBLIC_API_BASE_URL=https://gr8rtrackerapp.gr8rdesign.com
NEXT_PUBLIC_SOCKET_URL=https://gr8rtrackerapp.gr8rdesign.com
NEXT_PUBLIC_APP_ENV=production

# Feature flags
NEXT_PUBLIC_ENABLE_SCREENSHOTS=true
NEXT_PUBLIC_ENABLE_ACTIVITY_TRACKING=true
NEXT_PUBLIC_ENABLE_AUTO_UPDATE=true
