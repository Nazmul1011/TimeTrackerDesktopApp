{
  "name": "gr8r-timetracker-desktop",
  "version": "0.1.1",
  "description": "Gr8r Time Tracker + HRM Desktop Client",
  "private": true,
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "npm run electron:dev",
    "dev:web": "next dev",
    "start": "npm run electron:dev",
    "build": "next build",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,yml,yaml}\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:icon": "node scripts/ensure-dev-runtime.cjs",
    "electron": "npm run electron:compile && npm run electron:icon && node scripts/launch-electron.cjs",
    "electron:dev": "npm run electron:compile && npm run electron:icon && concurrently -k -n next,electron -c blue,magenta \"next dev -p 3000\" \"wait-on tcp:3000 && node scripts/launch-electron.cjs\"",
    "electron:build": "npm run build && npm run electron:compile && env -u ELECTRON_RUN_AS_NODE electron-builder",
    "electron:build:mac": "npm run build && npm run electron:compile && env -u ELECTRON_RUN_AS_NODE electron-builder --mac dmg zip",
    "electron:publish:mac": "npm run build && npm run electron:compile && env -u ELECTRON_RUN_AS_NODE electron-builder --mac dmg zip --publish always",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.83.0",
    "axios": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.13",
    "dotenv": "^16.6.1",
    "electron-log": "^5.4.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.6.2",
    "framer-motion": "^12.23.6",
    "lucide-react": "^0.525.0",
    "next": "^15.4.1",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.60.0",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.16.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "electron": "^37.2.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.1",
    "eslint-config-prettier": "^10.1.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.gr8r.timetracker",
    "productName": "Gr8r Time Tracker",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist-electron/**/*",
      "out/**/*",
      "public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.{node,dylib,so,dll}",
      "**/better-sqlite3/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icons/icon.icns",
      "identity": "Md shamir Rahman (7BK872D6A5)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Gr8r Time Tracker needs Automation access to detect which application you are using while the timer is running.",
        "NSScreenCaptureUsageDescription": "Gr8r Time Tracker needs Screen Recording permission to capture work screenshots while the timer is running.",
        "NSUserNotificationsUsageDescription": "Gr8r Time Tracker sends a notification when the timer pauses because you were idle."
      }
    },
    "afterPack": "./scripts/after-pack-mac-icon.cjs",
    "dmg": {
      "icon": "resources/icons/icon.icns",
      "iconSize": 80
    },
    "win": {
      "icon": "resources/icons/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "Nazmul1011",
      "repo": "TimeTrackerDesktopApp"
    }
  }
}
